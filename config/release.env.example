# Container images published by .github/workflows/publish-images.yml.
DASHBOARD_INSTALL_MODE=release
GHCR_OWNER=hillaybarbi64
DASHBOARD_IMAGE_TAG=0.1.0

# Local PostgreSQL. The installer replaces CHANGE_ME with a random value.
POSTGRES_USER=ibkr
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ibkr_dashboard
APP_SECRET_KEY=CHANGE_ME_APP

# The user signs in only inside the official IB Gateway application.
# 4001 = live; 4002 = paper. Read-only is enforced by the release compose file.
IBKR_GATEWAY_HOST=host.docker.internal
IBKR_GATEWAY_PORT=4001
IBKR_CLIENT_ID=17
IBKR_GATEWAY_AUTOSTART=true

# Historical read-only sync. Prefer entering these later in the dashboard.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Release deployments deliberately keep automatic Flex requests disabled.
IBKR_FLEX_AUTOSYNC=false

# Optional market news key. Leave empty to disable news.
FINNHUB_API_KEY=

LOG_LEVEL=INFO
LOG_FORMAT=console
ENVIRONMENT=local
SNAPSHOT_INTERVAL_MIN=15
DEFAULT_TIMEZONE=Asia/Jerusalem
