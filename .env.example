# ── Database ──────────────────────────────────────────────
# setup.sh generates a random password here automatically.
POSTGRES_USER=ibkr
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ibkr_dashboard
# Used when running the backend outside docker:
DATABASE_URL=postgresql+asyncpg://ibkr:CHANGE_ME@localhost:5432/ibkr_dashboard

# ── IB Gateway (live, read-only) ─────────────────────────
# The gateway runs on your Mac, outside docker. 4001 = live account.
IBKR_GATEWAY_HOST=host.docker.internal
IBKR_GATEWAY_PORT=4001
IBKR_CLIENT_ID=17
# Hard read-only. The connection layer refuses to start with false.
IBKR_READONLY=true

# ── Flex Web Service (historical sync, read-only) ────────
# Create in IBKR Client Portal — see docs/RUNBOOK.md section 3.
# Never commit real values. This file must contain placeholders only.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# ── App ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
ENVIRONMENT=local
SNAPSHOT_INTERVAL_MIN=15
DEFAULT_TIMEZONE=Asia/Jerusalem
